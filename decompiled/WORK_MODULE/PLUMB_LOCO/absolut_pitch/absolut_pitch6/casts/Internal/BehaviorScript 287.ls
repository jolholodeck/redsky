on exitFrame
  repeat with x = 11 to 19
    puppetSprite(x, 1)
  end repeat
  repeat with x = 40 to 47
    puppetSprite(x, 1)
  end repeat
  puppetSprite(26, 1)
  puppetSprite(27, 1)
  puppetSprite(25, 1)
  repeat with x = 50 to 65
    puppetSprite(x, 1)
  end repeat
  set the volume of sound 2 to 60
  puppetSprite(24, 1)
end
