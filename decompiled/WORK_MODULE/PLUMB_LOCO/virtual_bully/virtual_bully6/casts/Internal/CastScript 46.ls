on mouseUp
  global z
  if z = 0 then
    go("Hey")
  else
    if z = 1 then
      go("Leave")
    else
      if z = 2 then
        go("Quit it")
      else
        if z = 3 then
          go("Stop")
        else
          if z = 4 then
            go("Cut")
          else
            if z = 5 then
              go("Please")
            else
              if z = 6 then
                go("Stop it")
              else
                if z = 7 then
                  go("Knock")
                else
                  if z = 8 then
                    go("Why")
                  else
                    if z = 9 then
                      go("Love")
                    else
                      if z = 10 then
                        go("Gonna tell")
                      end if
                    end if
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
end
