+/// Red Sky preservation build: see the call site in the frame loop.
+async fn rs_hold_for_frame_wait() {
+    use crate::player::score::FrameWait;
+    let (wait, frame) = reserve_player_ref(|player| {
+        let f = player.movie.current_frame;
+        (player.movie.score.get_frame_wait(f), f)
+    });
+    let Some(wait) = wait else { return };
+    let started = chrono::Utc::now().timestamp_millis().abs();
+    let limit_ms: i64 = match wait {
+        FrameWait::Seconds(s) => (s as i64) * 1000,
+        _ => 10 * 60 * 1000, // safety cap for click/sound waits
+    };
+    loop {
+        let now = chrono::Utc::now().timestamp_millis().abs();
+        let elapsed = now - started;
+        let (done, interrupted) = reserve_player_ref(|player| {
+            let interrupted = !player.is_playing
+                || player.goto_wait_active
+                || player.movie.current_frame != frame;
+            let done = match wait {
+                FrameWait::Seconds(_) => elapsed >= limit_ms,
+                FrameWait::Click => player.last_mouse_down_time > started,
+                FrameWait::SoundRow(row) => {
+                    // Score row 3 plays on sound channel 2, row 4 on channel 1
+                    // (see the score sound trigger in score.rs).
+                    let idx = if row == 3 { 1 } else { 0 };
+                    let busy = player
+                        .sound_manager
+                        .get_channel(idx)
+                        .map(|ch| {
+                            let c = ch.borrow();
+                            c.status == crate::player::handlers::datum_handlers::sound_channel::SoundStatus::Playing
+                                || c.status == crate::player::handlers::datum_handlers::sound_channel::SoundStatus::Loading
+                        })
+                        .unwrap_or(false);
+                    // give a just-triggered sound a moment to start loading
+                    !busy && elapsed > 150
+                }
+            };
+            (done || elapsed >= limit_ms, interrupted)
+        });
+        if done || interrupted {
+            break;
+        }
+        let _ = async_std::future::timeout(
+            std::time::Duration::from_millis(16),
+            std::future::pending::<()>(),
+        ).await;
+        tick_sound_manager(0.016);
+        let active = reserve_player_ref(|player| {
+            player.is_playing && !player.is_script_paused && !player.pending_movie_init
+        });
+        if active {
+            let _ = player_invoke_frame_and_movie_scripts(Symbol::from_str("idle"), &vec![]).await;
+        }
+    }
+}
