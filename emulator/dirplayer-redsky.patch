+/// Red Sky preservation build: lay the accumulated trails over what has been drawn so far.
+fn rs_composite_trails(player: &DirPlayer, bitmap: &mut Bitmap) {
+    if let Some(trails_bmp) = &player.trails_bitmap {
+        if trails_bmp.width == bitmap.width && trails_bmp.height == bitmap.height {
