+
+/// Red Sky debug: score spans + sprite detail behaviors for a channel.
+#[wasm_bindgen]
+pub fn rs_debug_channel(channel: u32) -> String {
+    reserve_player_ref(|player| {
+        let score = &player.movie.score;
+        let mut out = String::new();
+        for s in score.sprite_spans.iter().filter(|s| s.channel_number == channel) {
+            out.push_str(&format!("span {}-{} scripts={:?}\n", s.start_frame, s.end_frame,
+                s.scripts.iter().map(|r| (r.cast_lib, r.cast_member)).collect::<Vec<_>>()));
+        }
+        for (f, ci, d) in score.channel_initialization_data.iter() {
+            if (*ci as u32) == channel + 5 && *f < 6 {
+                let idx = d.sprite_list_idx();
+                let beh = score.sprite_details.get(&idx).map(|sd| sd.behaviors.iter().map(|b| (b.cast_lib, b.cast_member)).collect::<Vec<_>>());
+                out.push_str(&format!("frame {} member {}:{} listIdx {} behaviors {:?}\n", f, d.cast_lib, d.cast_member, idx, beh));
+            }
+        }
+        out.push_str(&format!("sprite_details total {}\n", score.sprite_details.len()));
+        out
+    })
+}
