diff --git a/vm-rust/src/player/xtra/jsbridge.rs b/vm-rust/src/player/xtra/jsbridge.rs
new file mode 100644
index 0000000..a324521
--- /dev/null
+++ b/vm-rust/src/player/xtra/jsbridge.rs
@@ -0,0 +1,151 @@
+//! Red Sky preservation build: Xtras implemented by the host page in JavaScript.
+//!
+//! `new(xtra "Beatnik")` (and the other names in [`JS_XTRAS`]) creates an instance whose
+//! handler calls are forwarded to `window.__rsXtra(xtraName, instanceId, handler, args,
+//! movieBaseUrl)`. The page decides what each call does (e.g. runs the NeoBAE engine
+//! for Beatnik) and returns a number, string, boolean, array or nothing.
+//! Instance methods are also reachable as globals with the instance as first argument
+//! (`play(gxBeatnik, 0, "UI.rmf")`), as Director allowed.
+
+use std::sync::atomic::{AtomicU32, Ordering};
+
+use wasm_bindgen::JsValue;
+
+use crate::director::lingo::datum::{Datum, DatumType, XtraInstanceId};
+use crate::player::{reserve_player_mut, DatumRef, ScriptError};
+
+pub const JS_XTRAS: &[&str] = &["beatnik", "directconnection", "filextra", "textxtra", "muidialog", "mui", "glu32"];
+
+static NEXT_ID: AtomicU32 = AtomicU32::new(1);
+
+pub fn is_js_xtra(name: &str) -> bool {
+    let n = name.to_lowercase();
+    JS_XTRAS.iter().any(|x| *x == n)
+}
+
+pub fn js_available() -> bool {
+    web_sys::window()
+        .and_then(|w| js_sys::Reflect::get(&w, &JsValue::from_str("__rsXtra")).ok())
+        .map_or(false, |f| f.is_function())
+}
+
+pub fn create_instance(name: &str, args: &Vec<DatumRef>) -> XtraInstanceId {
+    let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+    let _ = call(name, id, "new", args);
+    id
+}
+
+fn datum_to_js(d: &DatumRef) -> JsValue {
+    reserve_player_mut(|player| to_js(player, d, 0))
+}
+
+fn to_js(player: &crate::player::DirPlayer, d: &DatumRef, depth: u32) -> JsValue {
+    match player.get_datum(d) {
+        Datum::Int(i) => JsValue::from_f64(*i as f64),
+        Datum::Float(f) => JsValue::from_f64(*f),
+        Datum::String(s) => JsValue::from_str(s),
+        Datum::StringChunk(_, _, s) => JsValue::from_str(s),
+        Datum::Symbol(s) => JsValue::from_str(&format!("#{}", s)),
+        Datum::List(_, items, _) if depth < 4 => {
+            let a = js_sys::Array::new();
+            for it in items {
+                a.push(&to_js(player, it, depth + 1));
+            }
+            a.into()
+        }
+        Datum::Void => JsValue::UNDEFINED,
+        other => match other.string_value() {
+            Ok(s) => JsValue::from_str(&s),
+            Err(_) => JsValue::NULL,
+        },
+    }
+}
+
+fn from_js(v: JsValue) -> DatumRef {
+    reserve_player_mut(|player| from_js_in(player, &v, 0))
+}
+
+fn from_js_in(player: &mut crate::player::DirPlayer, v: &JsValue, depth: u32) -> DatumRef {
+    if let Some(b) = v.as_bool() {
+        return player.alloc_datum(Datum::Int(if b { 1 } else { 0 }));
+    }
+    if let Some(f) = v.as_f64() {
+        return if f.fract() == 0.0 && f.abs() < 2_147_483_647.0 {
+            player.alloc_datum(Datum::Int(f as i32))
+        } else {
+            player.alloc_datum(Datum::Float(f))
+        };
+    }
+    if let Some(s) = v.as_string() {
+        if let Some(sym) = s.strip_prefix('#') {
+            return player.alloc_datum(Datum::Symbol(crate::player::symbols::symbol::Symbol::from_str(&sym.to_string())));
+        }
+        return player.alloc_datum(Datum::String(s));
+    }
+    if js_sys::Array::is_array(v) && depth < 4 {
+        let arr = js_sys::Array::from(v);
+        let mut items = std::collections::VecDeque::new();
+        for it in arr.iter() {
+            items.push_back(from_js_in(player, &it, depth + 1));
+        }
+        return player.alloc_datum(Datum::List(DatumType::List, items, false));
+    }
+    DatumRef::Void
+}
+
+pub fn call(name: &str, id: XtraInstanceId, handler: &str, args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let jargs = js_sys::Array::new();
+    for a in args {
+        jargs.push(&datum_to_js(a));
+    }
+    let base = reserve_player_mut(|player| {
+        player.net_manager.base_path.as_ref().map(|u| u.to_string()).unwrap_or_default()
+    });
+    let r = crate::player::handlers::datum_handlers::sound_channel::rs_js_call(
+        "__rsXtra",
+        &[
+            JsValue::from_str(&name.to_lowercase()),
+            JsValue::from_f64(id as f64),
+            JsValue::from_str(handler),
+            jargs.into(),
+            JsValue::from_str(&base),
+        ],
+    );
+    Ok(from_js(r))
+}
+
+/// Whether the page implements `handler` for this Xtra (so a global call like
+/// `play(gxBeatnik, ...)` goes to it, while `voidp(gxBeatnik)` stays a built-in).
+pub fn has_handler(name: &str, handler: &str) -> bool {
+    let r = crate::player::handlers::datum_handlers::sound_channel::rs_js_call(
+        "__rsXtraHas",
+        &[JsValue::from_str(&name.to_lowercase()), JsValue::from_str(handler)],
+    );
+    r.as_bool().unwrap_or(false)
+}
+
+/// Global (static) Xtra functions the page implements, e.g. FileXtra's
+/// `FileExists(path)` / `DirectoryToList(path)` answered from the work's file list.
+pub fn has_static(handler: &str) -> bool {
+    crate::player::handlers::datum_handlers::sound_channel::rs_js_call(
+        "__rsXtraStaticHas",
+        &[JsValue::from_str(handler)],
+    )
+    .as_bool()
+    .unwrap_or(false)
+}
+
+pub fn call_static(handler: &str, args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let jargs = js_sys::Array::new();
+    for a in args {
+        jargs.push(&datum_to_js(a));
+    }
+    let base = reserve_player_mut(|player| {
+        player.net_manager.base_path.as_ref().map(|u| u.to_string()).unwrap_or_default()
+    });
+    let r = crate::player::handlers::datum_handlers::sound_channel::rs_js_call(
+        "__rsXtraStatic",
+        &[JsValue::from_str(handler), jargs.into(), JsValue::from_str(&base)],
+    );
+    Ok(from_js(r))
+}
