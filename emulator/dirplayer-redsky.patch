+/// Red Sky preservation build: JS bridge for `sound playFile` with external
+/// files (AIFF on the original CD). The host page defines window.__rsPlayFile,
+/// __rsStopFile and __rsFileBusy.
+pub fn rs_js_call(name: &str, args: &[JsValue]) -> JsValue {
+    if let Some(w) = web_sys::window() {
+        if let Ok(f) = Reflect::get(&w, &JsValue::from_str(name)) {
+            if let Some(f) = f.dyn_ref::<js_sys::Function>() {
+                let arr = js_sys::Array::new();
+                for a in args {
+                    arr.push(a);
+                }
+                return f.apply(&JsValue::NULL, &arr).unwrap_or(JsValue::UNDEFINED);
+            }
+        }
+    }
+    JsValue::UNDEFINED
+}
