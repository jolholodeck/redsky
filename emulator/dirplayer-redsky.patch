+/// Red Sky preservation build: `puppetPalette(palette, speed, frames)`.
+/// DirPlayer renders in full color, so instead of swapping the stage palette
+/// the change is expressed as a stage brightness: the target palette's
+/// luminance relative to the frame's palette over the entries that differ.
+/// Palette2 (the film-flicker palette) gives a ~5% lift; a near-black palette
+/// gives a fade to black; `puppetPalette(0)` restores. Applied by the host
+/// page's `__rsStageFilter(brightness, durationMs)`.
+pub fn rs_puppet_palette(args: &[DatumRef]) {
+    use crate::director::lingo::datum::Datum;
+    use crate::player::bitmap::bitmap::PaletteRef;
+    let result = reserve_player_ref(|player| {
+        let palette_colors = |r: &CastMemberRef| -> Option<Vec<(u8, u8, u8)>> {
+            let m = player.movie.cast_manager.find_member_by_ref(r)?;
+            match &m.member_type {
+                crate::player::cast_member::CastMemberType::Palette(p) => Some(p.colors.clone()),
+                _ => None,
+            }
+        };
+        let target_ref: Option<CastMemberRef> = match args.first().map(|a| player.get_datum(a)) {
+            Some(Datum::String(n)) => player.movie.cast_manager.find_member_ref_by_name(n),
+            Some(Datum::CastMember(r)) => Some(r.clone()),
+            Some(Datum::Int(n)) if *n > 0 => Some(CastMemberRef { cast_lib: 1, cast_member: *n }),
+            _ => None,
+        };
+        let speed = args.get(1).and_then(|a| player.get_datum(a).int_value().ok()).unwrap_or(60);
+        let frames = args.get(2).and_then(|a| player.get_datum(a).int_value().ok()).unwrap_or(0);
+        let duration_ms = if frames > 0 {
+            frames as f64 * player.movie.get_frame_delay_ms()
+        } else if speed >= 60 || speed <= 0 {
+            0.0
+        } else {
+            (60 - speed) as f64 / 59.0 * 2000.0
+        };
+        let Some(target_ref) = target_ref else { return (1.0, duration_ms) };
+        let Some(target) = palette_colors(&target_ref) else { return (1.0, duration_ms) };
+        let reference = match player.movie.score.get_frame_palette(player.movie.current_frame) {
+            PaletteRef::Member(r) => palette_colors(&r),
+            _ => None,
+        };
+        let lum = |c: &(u8, u8, u8)| 0.299 * c.0 as f64 + 0.587 * c.1 as f64 + 0.114 * c.2 as f64;
+        let factor = match reference {
+            Some(refc) => {
+                let (mut a, mut b) = (0.0, 0.0);
+                for (t, r) in target.iter().zip(refc.iter()) {
+                    if t != r { a += lum(t); b += lum(r); }
+                }
+                if b > 0.0 { a / b } else { 1.0 }
+            }
+            None => {
+                // No frame palette to compare with: use the mean luminance
+                // against a neutral mid-gray reference.
+                let mean = target.iter().map(lum).sum::<f64>() / target.len().max(1) as f64;
+                (mean / 127.5).clamp(0.0, 2.0)
+            }
+        };
+        (factor.clamp(0.0, 3.0), duration_ms)
+    });
+    #[cfg(target_arch = "wasm32")]
+    {
+        crate::player::handlers::datum_handlers::sound_channel::rs_js_call(
+            "__rsStageFilter",
+            &[wasm_bindgen::JsValue::from_f64(result.0), wasm_bindgen::JsValue::from_f64(result.1)],
+        );
+    }
+    let _ = result;
+}
