diff --git a/vm-rust/src/player/rs_video.rs b/vm-rust/src/player/rs_video.rs
new file mode 100644
index 0000000..0bf46f9
--- /dev/null
+++ b/vm-rust/src/player/rs_video.rs
@@ -0,0 +1,86 @@
+//! Red Sky preservation build: QuickTime / digital video members.
+//!
+//! DirPlayer has no video decoder. A sprite whose member is a DigitalVideo is played by
+//! the page instead: each frame the player tells `window.__rsVideoFrame(list)` which video
+//! sprites are on stage, where, and from which file (the page lays a <video> over the
+//! stage, converted to MP4 under the original name). Lingo's video properties
+//! (movieRate, movieTime, duration, stopTime, volume) are forwarded to
+//! `window.__rsVideo(op, channel, file, value)`. Times are in ticks (1/60 s).
+
+use wasm_bindgen::JsValue;
+
+use crate::director::lingo::datum::Datum;
+use crate::player::cast_member::CastMemberType;
+use crate::player::DirPlayer;
+
+fn js(op: &str, ch: i16, file: &str, value: f64) -> JsValue {
+    crate::player::handlers::datum_handlers::sound_channel::rs_js_call(
+        "__rsVideo",
+        &[JsValue::from_str(op), JsValue::from_f64(ch as f64), JsValue::from_str(file), JsValue::from_f64(value)],
+    )
+}
+
+/// The linked file of the DigitalVideo member on `sprite`, if it has one.
+pub fn sprite_video_file(player: &DirPlayer, sprite: i16) -> Option<String> {
+    let s = player.movie.score.get_sprite(sprite)?;
+    let m = player.movie.cast_manager.find_member_by_ref(s.member.as_ref()?)?;
+    match &m.member_type {
+        CastMemberType::DigitalVideo(v) => Some(v.file_name.clone()),
+        _ => None,
+    }
+}
+
+pub fn is_video_prop(name: &str) -> bool {
+    matches!(name.to_lowercase().as_str(),
+        "movierate" | "movietime" | "duration" | "stoptime" | "starttime" | "volume" | "mediaready" | "loop" | "controller")
+}
+
+pub fn get_sprite_prop(player: &DirPlayer, sprite: i16, prop: &str) -> Option<Datum> {
+    let file = sprite_video_file(player, sprite)?;
+    let v = js(&format!("get:{}", prop.to_lowercase()), sprite, &file, 0.0);
+    Some(match v.as_f64() {
+        Some(f) => Datum::Int(f.round() as i32),
+        None => Datum::Int(0),
+    })
+}
+
+pub fn set_sprite_prop(player: &DirPlayer, sprite: i16, prop: &str, value: &Datum) -> bool {
+    let Some(file) = sprite_video_file(player, sprite) else { return false };
+    let v = match value {
+        Datum::Int(i) => *i as f64,
+        Datum::Float(f) => *f,
+        _ => 0.0,
+    };
+    js(&format!("set:{}", prop.to_lowercase()), sprite, &file, v);
+    true
+}
+
+/// Member duration in ticks (asks the page, which knows the converted file's length).
+pub fn member_duration(file: &str) -> i32 {
+    js("get:duration", 0, file, 0.0).as_f64().map(|f| f.round() as i32).unwrap_or(0)
+}
+
+/// Called after each stage draw: report every visible video sprite.
+pub fn report_frame(player: &DirPlayer) {
+    let list = js_sys::Array::new();
+    let base = player.net_manager.base_path.as_ref().map(|u| u.to_string()).unwrap_or_default();
+    for ch in &player.movie.score.channels {
+        let sp = &ch.sprite;
+        let Some(mref) = sp.member.as_ref() else { continue };
+        let Some(m) = player.movie.cast_manager.find_member_by_ref(mref) else { continue };
+        let CastMemberType::DigitalVideo(v) = &m.member_type else { continue };
+        if !sp.visible { continue; }
+        let o = js_sys::Object::new();
+        let set = |k: &str, val: JsValue| { let _ = js_sys::Reflect::set(&o, &JsValue::from_str(k), &val); };
+        set("channel", JsValue::from_f64(sp.number as f64));
+        set("file", JsValue::from_str(&v.file_name));
+        set("base", JsValue::from_str(&base));
+        let r = crate::player::score::get_concrete_sprite_rect(player, sp);
+        set("left", JsValue::from_f64(r.left as f64));
+        set("top", JsValue::from_f64(r.top as f64));
+        set("width", JsValue::from_f64((r.right - r.left) as f64));
+        set("height", JsValue::from_f64((r.bottom - r.top) as f64));
+        list.push(&o);
+    }
+    crate::player::handlers::datum_handlers::sound_channel::rs_js_call("__rsVideoFrame", &[list.into()]);
+}
