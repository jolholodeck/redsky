+/// Red Sky preservation build: Director leaves trails on the stage until something repaints
+/// them. Trails are kept until the movie changes (returns true: start over) and erased only
+/// where a sprite drawn last frame has moved, changed or gone (its old rect is repainted).
+pub fn rs_trails_dirty(player: &mut DirPlayer, channels: &[i16]) -> (bool, Vec<(i32, i32, i32, i32)>) {
+    let mut reset = false;
+    if player.rs_trails_movie != player.movie.file_name {
+        player.rs_trails_movie = player.movie.file_name.clone();
+        player.rs_trails_prev.clear();
+        player.rs_trails_top = 0;
+        reset = true;
+    }
+    let mut now: Vec<(i16, String, (i32, i32, i32, i32))> = Vec::new();
+    for &ch in channels {
+        if let Some(sprite) = player.movie.score.get_sprite(ch) {
+            if sprite.trails || !sprite.visible { continue; }
+            let Some(m) = sprite.member.as_ref() else { continue };
+            let r = get_concrete_sprite_rect(player, sprite);
+            now.push((ch, format!("{:?}", m), (r.left, r.top, r.right, r.bottom)));
+        }
+    }
+    let prev = std::mem::replace(&mut player.rs_trails_prev, Vec::new());
+    let dirty = prev
+        .into_iter()
+        .filter(|(ch, key, rect)| !now.iter().any(|(c, k, r)| c == ch && k == key && r == rect))
+        .map(|(_, _, r)| r)
+        .collect();
+    player.rs_trails_prev = now;
+    (reset, dirty)
+}
