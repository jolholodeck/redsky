 {
  "lib": "Internal",
  "num": 31,
  "name": "NetPages",
  "type": "field",
  "text": "--| STAMP URLs\n--| \u2022 Enter one URL per line.\n--| \u2022 Empty lines and lines starting with a double slash (--) are ignored.\n--| \u2022 URLs will be hex-encoded, so 'bad' characters are OK to use (eg. spaces, brackets, etc.).\n\n\n\n\n\n--STAMP  1 \u2022 EMBRACE THE LIMITATIONS\nembrace.htm\n\n--STAMP  2 \u2022 IMMERSE THE VIEWER...\nimmerse.htm\n\n--STAMP  3 \u2022 NOW THIS ICON IS AS DATED...\ndatedicon.htm\n\n--STAMP  4 \u2022 TECHNOLOGY CHANGES...\nchanges.htm\n\n--STAMP  5 \u2022 SHOOT FOR THE MOON\nshootmoon.htm\n\n--STAMP  6 \u2022 TECHNOLOGY DOESN'T MATTER\ntechmatter.htm\n\n--STAMP  7 \u2022 EVERYONE IS CREATIVE\neveryone.htm\n\n--STAMP  8 \u2022 NOTHING IS PERFECT...\nirregular.htm\n\n--STAMP  9 \u2022 PROGRESS, ADD, DELETE...\nprogress.htm\n\n--STAMP 10 \u2022 TECHNOLOGY IS NOT CONTENT\ncontent.htm\n\n"
 },
