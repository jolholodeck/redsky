on exitFrame
  global gCursorNum, gCursorMaskNum
  set the cursor of sprite 3 to [gCursorNum, gCursorMaskNum]
  set the cursor of sprite 4 to [gCursorNum, gCursorMaskNum]
  set the cursor of sprite 5 to [gCursorNum, gCursorMaskNum]
  set the cursor of sprite 10 to [gCursorNum, gCursorMaskNum]
  set the cursor of sprite 11 to [gCursorNum, gCursorMaskNum]
  set the cursor of sprite 12 to [gCursorNum, gCursorMaskNum]
  go("Idle2")
end
